{
  "name": "lexia-webapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0",
    "npm": ">=10"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "scripts": {
    "test:security": "tsx --test scripts/tests/security.test.ts",
    "test:workflow": "tsx --test scripts/tests/workflow.test.ts",
    "test:workflow-ui": "tsx --tsconfig tsconfig.tools.json --import ./scripts/tests/dom-setup.mjs --test scripts/tests/workflow.ui.test.tsx",
    "test:rules": "tsx --test scripts/tests/firestore.rules.test.ts",
    "test:persistence": "tsx --test scripts/tests/persistence.test.ts scripts/tests/transcript-store.test.ts scripts/tests/transcript-artifact-store.test.ts",
    "test:persistence-ui": "tsx --tsconfig tsconfig.tools.json --import ./scripts/tests/dom-setup.mjs --test scripts/tests/persistence.ui.test.tsx",
    "test:integrity": "tsx --test scripts/tests/document-integrity.test.ts",
    "test:integrity-ui": "tsx --tsconfig tsconfig.tools.json --import ./scripts/tests/dom-setup.mjs --test scripts/tests/document-integrity.ui.test.tsx",
    "qa:word": "tsx scripts/qa-word-export.ts",
    "qa:word-profiles": "tsx scripts/qa-word-profiles.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json && tsc -p tsconfig.tools.json",
    "test:unit": "tsx --test scripts/tests/security.test.ts scripts/tests/workflow.test.ts scripts/tests/document-integrity.test.ts scripts/tests/word-formatting.test.ts scripts/tests/transcript-word.test.ts scripts/tests/operations.test.ts scripts/tests/tasks.test.ts scripts/tests/guided.test.ts scripts/tests/transcript-segments.test.ts scripts/tests/worker-phase3.test.ts scripts/tests/direct-upload.test.ts scripts/tests/gemini.test.ts scripts/tests/generation-provider.test.ts",
    "test:ui": "tsx --tsconfig tsconfig.tools.json --import ./scripts/tests/dom-setup.mjs --test --test-concurrency=2 scripts/tests/workflow.ui.test.tsx scripts/tests/persistence.ui.test.tsx scripts/tests/document-integrity.ui.test.tsx scripts/tests/word-review.ui.test.tsx scripts/tests/transcript-word.ui.test.tsx scripts/tests/operations.ui.test.tsx scripts/tests/tasks.ui.test.tsx scripts/tests/guided.ui.test.tsx scripts/tests/transcript-phase3.ui.test.tsx scripts/tests/transcription-view-phase3.ui.test.tsx",
    "test": "npm run test:unit && npm run test:ui",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-lexia-security --config firebase.emulators.json \"npm run test:persistence && npm run test:rules\"",
    "check": "npm run lint && npm run build && npm test",
    "check:clean": "node scripts/check-clean-install.mjs",
    "check:env": "tsx scripts/check-environment.ts",
    "check:hosting": "tsx scripts/prepare-hosting.ts --check",
    "prepare:hosting": "tsx scripts/prepare-hosting.ts",
    "backup:scjn": "tsx scripts/backup-scjn.ts",
    "check:persistence": "tsx scripts/check-persistence.ts",
    "check:firestore-config": "tsx scripts/check-firestore-config.ts",
    "deploy:firestore": "tsx scripts/deploy-firestore.ts",
    "smoke:persistence": "tsx scripts/smoke-persistence.ts",
    "smoke:gemini": "tsx scripts/smoke-gemini.ts",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "scjn:import": "tsx scripts/scjn-import.ts",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.build.json",
    "start": "node dist-server/server/index.js",
    "start:production": "node --import ./scripts/production-env.mjs dist-server/server/index.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:knowledge": "tsx scripts/check-knowledge.ts",
    "check:worker": "npm --prefix workers/transcriptor-legal run check:worker"
  },
  "dependencies": {
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.1",
    "axios": "^1.20.0",
    "better-sqlite3": "~12.10.0",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "docx": "^9.6.1",
    "dompurify": "^3.4.15",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fast-xml-parser": "^5.11.1",
    "file-saver": "^2.0.5",
    "file-type": "^22.1.1",
    "firebase": "^12.12.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.8.0",
    "mammoth": "^1.12.3",
    "multer": "^2.4.0",
    "openai": "^7.15.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.1",
    "tsx": "^4.23.13",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/file-saver": "^2.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-pwa": "^1.3.0"
  },
  "allowScripts": {
    "@firebase/util@1.15.0": true,
    "@firebase/util@1.15.3": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "better-sqlite3@12.10.1": true
  }
}
