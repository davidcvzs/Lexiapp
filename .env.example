# =============================================================================
# LexIA Webapp — Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git.
#
# Usage:
#   cp .env.example .env.local
# =============================================================================

# ---------------------------------------------------------------------------
# Server — General
# ---------------------------------------------------------------------------
NODE_ENV=development          # Set to 'production' in production/staging
PORT=3000                     # Express server port (default: 3000)

# CORS: allow frontend on a different origin (leave empty in production
# when frontend is served by the same Express process).
APP_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=               # Your OpenAI API key (sk-...)
OPENAI_MODEL=gpt-5.6-sol      # Model to use (default: gpt-5.6-sol)
OPENAI_REASONING_EFFORT=medium # low | medium | high (currently reserved)

# ---------------------------------------------------------------------------
# SCJN SQLite Database
# ---------------------------------------------------------------------------
# Default (local dev): data/scjn/scjn.db (relative to project root)
# Production / Docker: set an absolute path inside a persistent volume.
# Example for Docker: /data/scjn.db
SCJN_DB_PATH=                 # Leave empty to use default: data/scjn/scjn.db

# ---------------------------------------------------------------------------
# Firebase (Frontend — VITE_ prefix required)
# ---------------------------------------------------------------------------
# These values are embedded in the compiled frontend bundle at build time.
# They are NOT secrets; Firebase security is enforced via Firestore rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
