VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server: leave NODE_ENV=development locally; start:production sets production.
NODE_ENV=development
PORT=3000
# Empty means frontend/API share an origin. Set an HTTPS origin for split deployment.
APP_ORIGIN=
# Number of trusted reverse proxy hops; 0 for direct access, configure for your ingress.
TRUST_PROXY_HOPS=0

# Firebase Admin: either workload identity / GOOGLE_APPLICATION_CREDENTIALS or this pair.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

CLOUDFLARE_WORKER_URL=
CLOUDFLARE_TRANSCRIPTION_SECRET=
# Independent backend credential matching LEXIA_API_KEY in the repaired Worker.
CLOUDFLARE_BACKEND_SECRET=
# Enable only after deploying/configuring the repaired Worker and verifying Stream TUS.
CLOUDFLARE_DIRECT_UPLOAD_ENABLED=false

SCJN_DB_DRIVER=sqlite
SCJN_DB_PATH=

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
INSTANCE_CONNECTION_NAME=

OPENAI_API_KEY=
OPENAI_MODEL=
# Explicit generation provider: openai or gemini. No automatic provider fallback.
AI_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Absolute server-only path; defaults to ./conocimiento (lowercase on Linux).
KNOWLEDGE_DIR=
